{% extends 'base.html.twig' %}

{% block title %}Doctrine Deadlock Retry Bundle - Demo - {{ version_badge }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Doctrine Deadlock Retry Bundle',
        intro: 'Flush the Doctrine unit of work and retry it on a database deadlock or lock wait timeout.',
    }) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header">
            <h2 class="nowo-ui-card__title">Flush with retry <span class="nowo-ui-badge nowo-ui-badge--info">{{ version_badge }}</span></h2>
        </div>
        <div class="nowo-ui-card__body">
            <p>Each page load persists a <code class="nowo-ui-code">DemoNote</code> and calls <code class="nowo-ui-code">DeadlockRetryService::flush()</code> (default profile).</p>
            <table class="nowo-ui-data-table">
                <tbody>
                    <tr><th scope="row">Latest saved</th><td><code class="nowo-ui-code">#{{ latest_note.id }} — {{ latest_note.title }}</code></td></tr>
                    <tr><th scope="row">Configured profiles</th><td>{{ profiles|join(', ') }}</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Recent notes</h2></div>
        <div class="nowo-ui-card__body">
            {% if notes is empty %}
                <p class="nowo-ui-muted">No notes yet.</p>
            {% else %}
                <table class="nowo-ui-data-table">
                    <thead>
                        <tr><th scope="col">ID</th><th scope="col">Title</th><th scope="col">Created</th></tr>
                    </thead>
                    <tbody>
                        {% for note in notes %}
                        <tr>
                            <td>{{ note.id }}</td>
                            <td>{{ note.title }}</td>
                            <td>{{ note.createdAt|date('Y-m-d H:i:s') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Usage in your app</h2></div>
        <div class="nowo-ui-card__body">
<pre class="nowo-ui-code-block"><code>$this->entityManager->persist($entity);
$this->deadlockRetry->flush();
$this->deadlockRetry->flush('batch');</code></pre>
        </div>
    </section>
{% endblock %}
