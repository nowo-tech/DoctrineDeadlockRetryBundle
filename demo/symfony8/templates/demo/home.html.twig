{% extends 'base.html.twig' %}

{% block title %}Doctrine Deadlock Retry Bundle - Demo - {{ version_badge }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Doctrine Deadlock Retry Bundle',
        intro: 'Flush the Doctrine unit of work and retry it on a database deadlock or lock wait timeout.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Flush with retry', intro: 'Each page load persists a DemoNote and calls DeadlockRetryService::flush() (default profile).', kind: 'table'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">{{ version_badge }}</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <tbody>
                    <tr><th scope="row">Latest saved</th><td><code class="nowo-ui-code">#{{ latest_note.id }} — {{ latest_note.title }}</code></td></tr>
                    <tr><th scope="row">Configured profiles</th><td>{{ profiles|join(', ') }}</td></tr>
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Recent notes', kind: 'table', empty: notes is empty, state_message: 'No notes yet.'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr><th scope="col">ID</th><th scope="col">Title</th><th scope="col" class="nowo-ui-cell--date">Created</th></tr>
                </thead>
                <tbody>
                    {% for note in notes %}
                    <tr>
                        <td>{{ note.id }}</td>
                        <td>{{ note.title }}</td>
                        <td class="nowo-ui-cell--date"><time datetime="{{ note.createdAt|date('c') }}">{{ note.createdAt|date('Y-m-d H:i:s') }}</time></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Usage in your app', kind: 'content'} %}
        {% block section_body %}
<pre class="nowo-ui-code-block" tabindex="0"><code>$this->entityManager->persist($entity);
$this->deadlockRetry->flush();
$this->deadlockRetry->flush('batch');</code></pre>
        {% endblock %}
    {% endembed %}
{% endblock %}
